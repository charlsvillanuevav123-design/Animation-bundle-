	btn.Activated:Connect(function()
		local ok = applyPack(name)
		currentLabel.Text = ok and ("Current: " .. name) or ("Current: (failed) " .. name)
	end)

	buttonsByName[name] = btn
end

for i, name in ipairs(allNames) do
	createButton(name, i)
end
refreshCanvas()

local function applyFilter(text)
	text = (text or ""):lower()
	for name, btn in pairs(buttonsByName) do
		btn.Visible = (text == "") or (name:lower():find(text, 1, true) ~= nil)
	end
	refreshCanvas()
end

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	applyFilter(searchBox.Text)
end)
applyFilter("")

task.defer(function()
	local saved = player:GetAttribute(ATTR_LAST)
	if type(saved) == "string" and saved ~= "" and PACKS[saved] then
		currentLabel.Text = "Current: " .. saved .. " (saved)"
		task.wait(0.2)
		applyPack(saved)
	end
end)


--// ============ MINECRAFT-STYLE CHAT (2 lines, bottom-to-top, min 1/4 screen width bubbles) ============
local CHAT_LIFETIME = 20
local HISTORY_LINES = 12
local MAX_LIVE = 2
local CHAT_TEXT_SIZE = 17

-- remove any leftover chat GUI from previous executions
local oldChat = pg:FindFirstChild("CleanChatGUI")
if oldChat then oldChat:Destroy() end

local chatGui = Instance.new("ScreenGui")
chatGui.Name = "CleanChatGUI"
chatGui.ResetOnSpawn = false
chatGui.DisplayOrder = 10
chatGui.Parent = pg

-- full history (shown when the Roblox chat window is OPEN)
local chatFrame = Instance.new("Frame")
chatFrame.Name = "ChatHistoryArea"
chatFrame.BackgroundTransparency = q
chatFrame.Size = UDim2.new(0, 420, 0, 220)
chatFrame.Position = UDim2.new(0, 12, 0, 44)
chatFrame.Visible = false
chatFrame.Parent = chatGui

local chatList = Instance.new("UIListLayout")
chatList.Padding = UDim.new(0, 2)
chatList.SortOrder = Enum.SortOrder.LayoutOrder
chatList.VerticalAlignment = Enum.VerticalAlignment.Bottom
chatList.Parent = chatFrame

-- live 2-line area, anchored at the BOTTOM so messages push UP
local liveContainer = Instance.new("Frame")
liveContainer.Name = "LiveChatArea"
liveContainer.BackgroundTransparency = 1
liveContainer.AnchorPoint = Vector2.new(0, 1)
liveContainer.Position = UDim2.new(0, 12, 0, 58)
liveContainer.Size = UDim2.new(0, 420, 0, 0)
liveContainer.AutomaticSize = Enum.AutomaticSize.Y
liveContainer.Parent = chatGui

local liveLayout = Instance.new("UIListLayout")
liveLayout.Padding = UDim.new(0, 2)
liveLayout.SortOrder = Enum.SortOrder.LayoutOrder
liveLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
liveLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
liveLayout.Parent = liveContainer

local msgCount = 0
local historyOn = false

--// DEDUPLICATION
local recent = {}
local function isDuplicate(senderPlayer, message)
	local key = senderPlayer.Name .. "|" .. message
	local now = os.clock()
	if recent[key] and (now - recent[key]) < 2 then
		return true
	end
	recent[key] = now
	for k, t in pairs(recent) do
		if (now - t) > 5 then recent[k] = nil end
	end
	return false
end

local function getSenderName(senderPlayer)
	return senderPlayer and senderPlayer.DisplayName or "?"
end

--// RANDOM COLOR for chat text
local function randomChatColor()
	return Color3.fromRGB(
		math.random(0, 255),
		math.random(0, 255),
		math.random(0, 255)
	)
end

local function addHistoryMessage(senderName, message)
	msgCount += 1
	local label = Instance.new("TextLabel")
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.Size = UDim2.new(0.25, 0, 0, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Code
	label.TextSize = CHAT_TEXT_SIZE
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.TextColor3 = randomChatColor()
	label.TextWrapped = false
	label.Text = senderName .. ": " .. message
	label.LayoutOrder = msgCount
	label.Parent = chatFrame

	local labels = {}
	for _, child in ipairs(chatFrame:GetChildren()) do
		if child:IsA("TextLabel") then table.insert(labels, child) end
	end
	if #labels > HISTORY_LINES then
		table.sort(labels, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
		labels[1]:Destroy()
	end
end

local function showLiveMessage(senderName, message)
	msgCount += 1
	local label = Instance.new("TextLabel")
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.Size = UDim2.new(1, 0, 0, 10) -- MINIMUM 1/4 of screen width
	label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	label.BackgroundTransparency = 0.55 -- background is back
	label.Font = Enum.Font.Code
	label.TextSize = CHAT_TEXT_SIZE
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.TextColor3 = randomChatColor()
	label.TextWrapped = true -- longer text wraps and the bubble GROWS taller
	label.Text = senderName .. ": " .. message
	label.LayoutOrder = msgCount -- newest at the BOTTOM, older pushed UP
	label.Parent = liveContainer
	Instance.new("UICorner", label).CornerRadius = UDim.new(0, 4)

	-- keep only the newest 2
	local labels = {}
	for _, child in ipairs(liveContainer:GetChildren()) do
		if child:IsA("TextLabel") then table.insert(labels, child) end
	end
	if #labels > MAX_LIVE then
		table.sort(labels, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
		for i = 1, #labels - MAX_LIVE do
			labels[i]:Destroy()
		end
	end

	task.delay(CHAT_LIFETIME, function()
		if label.Parent then
			TweenService:Create(label, TweenInfo.new(1), {
				TextTransparency = 1,
				BackgroundTransparency = 1,
			}):Play()
			task.delay(1, function()
				if label.Parent then label:Destroy() end
			end)
		end
	end)
end

local function clearLiveMessages()
	for _, child in ipairs(liveContainer:GetChildren()) do
		if child:IsA("TextLabel") then child:Destroy() end
	end
end

local function onChat(senderPlayer, message)
	if not senderPlayer then return end
	if isDuplicate(senderPlayer, message) then return end
	local senderName = getSenderName(senderPlayer)
	addHistoryMessage(senderName, message)
	if not historyOn then
		showLiveMessage(senderName, message)
	end
end

-- detect built-in chat open/closed
task.spawn(function()
	while chatGui.Parent do
		local visible = false
		pcall(function()
			local chatDefault = pg:FindFirstChild("Chat")
			if chatDefault then
				local window = chatDefault:FindFirstChild("ChatWindow")
				local f = chatDefault:FindFirstChild("Frame")
				if window then
					visible = window.Visible
				elseif f then
					local ccp = f:FindFirstChild("ChatChannelParentFrame")
					visible = (ccp and ccp.Visible) or f.Visible
				end
			end
		end)
		if visible ~= historyOn then
			historyOn = visible
			chatFrame.Visible = historyOn
			if historyOn then
				clearLiveMessages()
			end
		end
		task.wait(0.15)
	end
end)

-- hook messages
local function hookPlayer(plr)
	plr.Chatted:Connect(function(msg)
		onChat(plr, msg)
	end)
end
for _, plr in ipairs(Players:GetPlayers()) do hookPlayer(plr) end
Players.PlayerAdded:Connect(hookPlayer)

pcall(function()
	TextChatService.OnIncomingMessage = function(msg)
		if msg.TextSource then
			local sender = Players:FindFirstChild(msg.TextSource.Name)
			task.defer(onChat, sender, msg.Text)
		end
		return nil
	end
end)
