--// ============ PERMANENT DOUBLE JUMP ============
local DOUBLE_JUMP_POWER = 50

local function setupDoubleJump(char)
	local hum = char:WaitForChild("Humanoid")
	local canDoubleJump = false
	local hasDoubleJumped = false

	hum.StateChanged:Connect(function(_, newState)
		if newState == Enum.HumanoidStateType.Jumping then
			if not hasDoubleJumped then
				canDoubleJump = true
			end
		elseif newState == Enum.HumanoidStateType.Freefall then
			task.wait(0.15)
			canDoubleJump = true
		end
	end)

	hum.Jumping:Connect(function()
		if canDoubleJump and not hasDoubleJumped then
			hasDoubleJumped = true
			canDoubleJump = false
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
			local root = char:FindFirstChild("HumanoidRootPart")
			if root then
				local vel = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(vel.X, DOUBLE_JUMP_POWER, vel.Z)
			end
		end
	end)

	hum.StateChanged:Connect(function(_, newState)
		if newState == Enum.HumanoidStateType.Landed
			or newState == Enum.HumanoidStateType.Running
			or newState == Enum.HumanoidStateType.Swimming then
			canDoubleJump = false
			hasDoubleJumped = false
		end
	end)
end

if player.Character then
	task.spawn(setupDoubleJump, player.Character)
end
player.CharacterAdded:Connect(setupDoubleJump)

